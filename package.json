{
  "name": "reelkit",
  "version": "0.5.2",
  "description": "Free, local, Claude-Code-driven short-form video pipeline: research, script, voice, render, post, analyze, repurpose.",
  "type": "module",
  "bin": {
    "reelkit": "bin/reelkit.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node bin/reelkit.mjs dashboard --open",
    "app": "npx --yes electron app/main.cjs",
    "dist:win": "npx --yes electron-builder --win nsis",
    "dist:mac": "npx --yes electron-builder --mac dmg"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@playwright/mcp": "^0.0.86",
    "playwright-core": "^1.49.0"
  },
  "main": "app/main.cjs",
  "optionalDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "local.reelkit.app",
    "productName": "Reelkit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "bin/**",
      "src/**",
      "render/**",
      "styles/**",
      "web/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}